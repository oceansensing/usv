---
/**
 * The shell one figure lives in: a title, an SVG, a pointer readout, a
 * caption, and the controls that drive them.
 *
 * Everything is found by `data-plot-*` attribute rather than by id, because
 * a page carries several of these. `makeFigure` in `lib/figure.ts` is what
 * wires them.
 */

interface Props {
  title: string;
  /** Placed on the element so the caller can find this figure. */
  id: string;
  /** Shown under the title, before any data has arrived. */
  hint?: string;
}

const { title, id, hint } = Astro.props;
---

<figure class="plot" data-figure={id}>
  <figcaption class="head">
    <h3 class="figure-title">{title}</h3>
    <p class="hover mono" data-plot-hover aria-live="off"></p>
  </figcaption>

  <svg data-plot-svg role="img" aria-label={title}>
    <title>{title}</title>
  </svg>

  <p class="caption" data-plot-caption>{hint ?? ''}</p>

  <div class="controls">
    <label>
      <span class="eyebrow">x</span>
      <select class="field" data-plot-x></select>
    </label>
    <label>
      <span class="eyebrow">y</span>
      <select class="field" data-plot-y></select>
    </label>
    <label>
      <span class="eyebrow">color</span>
      <select class="field" data-plot-c></select>
    </label>
    <label>
      <span class="eyebrow">scale</span>
      <select class="field" data-plot-map></select>
    </label>
    <span class="ramp" data-plot-ramp aria-hidden="true"></span>
    <button class="btn" type="button" data-plot-flip aria-pressed="false">y down</button>
    <button class="btn" type="button" data-plot-png>PNG</button>
  </div>

  <details class="aside more">
    <summary>Limits and drawing</summary>
    <div class="controls">
      <label class="pair">
        <span class="eyebrow">x from</span>
        <input class="field" type="number" step="any" data-plot-x-lo />
      </label>
      <label class="pair">
        <span class="eyebrow">to</span>
        <input class="field" type="number" step="any" data-plot-x-hi />
      </label>
      <label class="pair">
        <span class="eyebrow">y from</span>
        <input class="field" type="number" step="any" data-plot-y-lo />
      </label>
      <label class="pair">
        <span class="eyebrow">to</span>
        <input class="field" type="number" step="any" data-plot-y-hi />
      </label>
      <label class="pair">
        <span class="eyebrow">color from</span>
        <input class="field" type="number" step="any" data-plot-c-lo />
      </label>
      <label class="pair">
        <span class="eyebrow">to</span>
        <input class="field" type="number" step="any" data-plot-c-hi />
      </label>
      <label class="pair">
        <span class="eyebrow">height</span>
        <input class="field" type="number" min="160" max="1200" step="10" value="380" data-plot-h />
      </label>
      <label class="pair">
        <span class="eyebrow">dot</span>
        <input class="field" type="number" min="0.5" max="12" step="0.5" value="2.5" data-plot-dot />
      </label>
      <label class="pair">
        <span class="eyebrow">steps</span>
        <input class="field" type="number" min="2" max="256" step="1" value="24" data-plot-steps />
      </label>
      <label class="pair">
        <span class="eyebrow">style</span>
        <select class="field" data-plot-style>
          <option value="dots">dots</option>
          <option value="line">line</option>
          <option value="both">both</option>
        </select>
      </label>
      <button class="btn" type="button" data-plot-reset>Reset</button>
    </div>
  </details>
</figure>

<style>
  .plot {
    margin: 0 0 var(--space-xl);
  }

  /* `nowrap`: the readout is a fixed slot that shrinks, so the row is always
     one line and its height cannot change when text appears. */
  .head {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    margin-block-end: var(--space-xs);
  }

  /* Size and weight come from `.figure-title` in global.css, which every
     figure on the site shares; only the head's layout is this figure's. */
  h3 {
    flex: 0 1 auto;
    min-width: 0;
  }

  .hover {
    margin-inline-start: auto;
  }

  svg {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    touch-action: none;
  }

  .caption {
    margin-block-start: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-xs) var(--space-sm);
    margin-block-start: var(--space-sm);
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pair input,
  .pair select {
    width: 9rem;
  }

  .ramp {
    display: flex;
    height: 1.6rem;
    width: 6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .more {
    margin-block-start: var(--space-xs);
  }
</style>

<style is:global>
  /* The plot's own linework. Global because every node inside the SVG is
     built by a script, and Astro's scoping attribute is stamped on compiled
     markup only — a scoped `.trace` would match nothing and the plot would
     render as black fills on black strokes.
     Anchored under `[data-figure]` so it is still confined to these
     figures rather than every SVG on the page. */
  [data-figure] .axis {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }

  /* `fill: none` is not optional: an SVG path fills by default, so without
     it the two-legged axis renders as a solid triangle across the plot. */
  [data-figure] .trace {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  [data-figure] .tick {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  [data-figure] .axis-name {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  [data-figure] .color-frame {
    fill: none;
    stroke: var(--border);
  }

  [data-figure] .ring {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    pointer-events: none;
  }

  /* The band drawn while a reader sweeps across a section to pick a time
     range. `pointer-events: none` because it sits under the cursor for the
     whole gesture and would otherwise swallow the pointerup that ends it. */
  [data-figure] .select-band {
    fill: var(--accent);
    fill-opacity: 0.16;
    stroke: var(--accent);
    stroke-width: 1;
    pointer-events: none;
  }

  [data-figure] .isopycnal {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 0.7;
    opacity: 0.55;
  }

  [data-figure] .isopycnal-label {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  [data-plot-ramp] span {
    flex: 1;
  }

  /**
   * The pointer readout's slot, and it is a *slot*: fixed height, one line,
   * never wraps.
   *
   * It used to be an ordinary paragraph in a wrapping flex row, so the text
   * that appeared on hover was free to take a second and third line. In the
   * T–S diagram's half-width column it took all three — the figure's head
   * grew from 26 px to 80 px and the plot dropped 54 px, out from under the
   * pointer that had just summoned it. Measured at 1280×900.
   *
   * Three things together make the height constant, and all three are
   * needed. `flex: 1 1 0` with `min-width: 0` lets the slot shrink instead
   * of pushing itself onto a line of its own. `white-space: nowrap` with
   * `overflow: hidden` stops long text adding lines. And an explicit
   * `line-height` matched by `min-height` makes the empty box exactly as
   * tall as the full one — without it the row still grew 1.3 px when text
   * appeared, which is small and still visible as a twitch.
   *
   * Global rather than scoped because the section figures are clones of a
   * prototype and this is a contract of the figure, not decoration.
   */
  [data-plot-hover] {
    flex: 1 1 0;
    min-width: 0;
    text-align: end;
    white-space: nowrap;
    overflow: hidden;
    line-height: 1.4;
    min-height: 1.4em;
    color: var(--text-muted);
    /* Hidden rather than emptied, so the slot keeps its width and the figure
       does not twitch as the pointer leaves and re-enters. */
    visibility: hidden;
  }

  [data-plot-hover].live {
    visibility: visible;
  }

  /**
   * One value, in a slot of fixed width.
   *
   * The vertical fix above stopped the plot moving; this stops the *labels*
   * moving. Right-aligned with free-width numbers, `32.1102` becoming `9.87`
   * shortened the line and slid every label left under the pointer. A fixed
   * `ch` width with tabular figures makes the line the same length whatever
   * the numbers are.
   *
   * **Aligned to the start, and that is not cosmetic.** Reserving nine
   * characters means a six-character value leaves three characters of slack
   * somewhere, and right-alignment put all of it *between the label and its
   * own number* — "SA" and "32.11" drifting apart as the digits changed.
   * Aligned to the start, the number sits against its label and the slack
   * falls before the separator, where it reads as the gap between groups
   * that it already was.
   *
   * Nine characters covers a signed four-decimal number, in-situ density's
   * `1024.4896` included; anything wider pushes rather than being reserved
   * for on every figure.
   */
  [data-plot-hover] .ro-v {
    display: inline-block;
    min-width: 9ch;
    text-align: start;
    font-variant-numeric: tabular-nums;
  }

  /* A clock is nineteen characters, and reserving that on every numeric axis
     would be most of a narrow figure's width. */
  [data-plot-hover] .ro-time {
    min-width: 19ch;
  }
</style>
