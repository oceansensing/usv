---
import { LAB, NAV, SITE } from '../config';
import { isCurrent, withBase } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

// Wide on the figure pages, so the chrome starts at the same left edge the
// map and the sections do. See BaseLayout's `wide` prop.
const { wide = false } = Astro.props;
---

<header>
  <div class={`container inner${wide ? ' wide' : ''}`}>
    <div class="brand">
      {/* The lab this site belongs to, above the wordmark rather than inside
          `nav`. Two reasons, and the second is the load-bearing one: it is a
          parent rather than a peer of this site's own pages, and `test:pages`
          asserts every `nav a` points into the base path — an absolute URL in
          there would fail a check that is right. The footer has carried this
          link since the site was built; a reader deep in a figure page never
          sees it. */}
      <a class="lab" href={LAB.url}>← {LAB.name}</a>
      <a class="wordmark" href={withBase('/')}>
        {SITE.title}<span class="wordmark-sub">{SITE.fullName}</span>
      </a>
    </div>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    flex-wrap: wrap;
    padding-block: var(--space-md);
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    color: var(--text);
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .wordmark:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .lab {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    align-self: flex-start;
    line-height: 1.2;
  }

  .lab:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .wordmark-sub {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0;
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    list-style: none;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-block: var(--space-2xs);
  }

  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
  }

  @media (max-width: 48rem) {
    .inner {
      justify-content: space-between;
    }

    nav {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
    }
  }
</style>
